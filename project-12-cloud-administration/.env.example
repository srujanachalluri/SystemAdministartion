# Copy to .env and fill in. .env is gitignored -- never commit a real key.
#
#   cp .env.example .env
#   nano .env
#   set -a && source .env && set +a
#
# ---------------------------------------------------------------------------
# PORTABILITY NOTE (this is the anti-lock-in hedge, and it is graded)
#
# The application code does not change when the provider changes. Only the
# three variables below change, because app/donor_letters.py is written against
# the OpenAI-compatible /v1/chat/completions shape. Switching vendors is an
# edit to a config file, not a rewrite.
# ---------------------------------------------------------------------------

# === ACTIVE: OpenRouter, free tier ==========================================
# Limits: 20 requests/minute, 50 requests/day (accounts that have never bought
# credits). Run with --rpm 15 to stay under the per-minute ceiling.
#
# openai/gpt-oss-20b:free is the SAME model as the paid openai/gpt-oss-20b
# ($0.03/1M in, $0.13/1M out). That lets COST_REPORT compare free vs paid on
# an identical workload instead of guessing across different models.
PROVIDER_BASE_URL=https://openrouter.ai/api/v1
PROVIDER_API_KEY=sk-or-REPLACE-ME
MODEL_ID=openai/gpt-oss-20b:free

# Alternate free models on the same account (swap MODEL_ID only):
#   google/gemma-4-31b-it:free          (paid twin: $0.10/1M in, $0.34/1M out)
#   nvidia/nemotron-3-nano-9b-v2:free
#   inclusionai/ling-3.0-flash:free

# === Alternate: OpenAI Platform (paid, ~$0.01 for 40 requests) ==============
# PROVIDER_BASE_URL=
# PROVIDER_API_KEY=sk-REPLACE-ME
# MODEL_ID=gpt-4o-mini

# Re-verify model IDs, rate limits, and prices at the provider console before
# relying on them. Everything above is a snapshot, and snapshots drift --
# a model ID that worked last month may be deprecated today.
